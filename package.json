{
  "name": "pomodoro-timer",
  "version": "1.0.0",
  "description": "桌面番茄钟 - 计时、任务管理、历史追踪",
  "main": "main.js",
  "author": "Pomodoro Timer Contributors",
  "license": "MIT",
  "keywords": [
    "pomodoro",
    "timer",
    "productivity",
    "electron",
    "desktop"
  ],
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.pomodoro.timer",
    "productName": "番茄钟",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "*.png",
      "*.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  }
}
